# Derived ComfyUI image (gfx1151) — bakes the detailer/upscaler custom-node Python
# dependencies into the upstream image's venv (/opt/venv).
#
# Why an image and not a runtime install: the oci-containers service recreates the
# container on every restart (podman rm -f + fresh podman run), discarding its
# writable layer. Deps pip-installed into a running container therefore do NOT
# survive a restart — they must be in the image. Custom-node *code* and models live
# in the /storage/comfyui volume and persist independently; only their Python deps
# are baked here.
#
# Build out-of-band with rootful podman so the (root) oci-containers service can see
# the resulting image:
#
#   cd /etc/nixos/ai-lab/comfyui && sudo podman build -t localhost/comfyui-gfx1151-impact:v0.2-7 .
#
# Then deploy the server and `sudo systemctl restart podman-comfyui`. Bump the tag
# (…-2, …-3) when changing deps so the service picks up the new image.

# Base pinned by digest (== upstream :v0.2) for reproducibility — a moving tag could
# change under us; the digest cannot.
FROM docker.io/ignatberesnev/comfyui-gfx1151@sha256:a38260b56a94fdf5aa9f951a96a73ef1987b70ebcbd4757447708a756a67abc0

# Impact Pack + Impact Subpack (detectors) + Ultimate SD Upscale dependencies.
# torch / transformers / numpy / scipy / matplotlib are already in the base venv.
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      opencv-python-headless \
      scikit-image \
      piexif \
      dill \
      segment-anything \
      ultralytics \
      "git+https://github.com/facebookresearch/sam2"

# ControlNet preprocessors (comfyui_controlnet_aux). CPU onnxruntime (this box is
# AMD/ROCm — onnxruntime-gpu is NVIDIA-only). mediapipe is intentionally OMITTED: it
# can force a numpy<2 downgrade that breaks torch, and OpenPose/DWPose/depth/canny/
# lineart don't need it (only the mediapipe-face preprocessor does).
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      onnxruntime \
      einops \
      fvcore \
      yapf \
      ftfy \
      addict \
      yacs \
      "trimesh[easy]" \
      albumentations \
      scikit-learn \
      importlib_metadata

# IP-Adapter FaceID: insightface for face detection + identity embeddings, giving strong
# single-subject face consistency (IPAdapterFaceID / IPAdapterInsightFaceLoader nodes).
# Wheel-installed (no compile expected); onnxruntime(CPU) is already present above. The 2D
# FaceAnalysis path we use is onnxruntime-based, so numpy 2.x stays intact (verify after build).
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      insightface \
      onnx

# EchoMimicV3 (ComfyUI_EchoMimic) — audio-driven talking avatar. Portrait plus a
# voice clip to a video of that portrait speaking. Apache-2.0 code AND weights,
# 1.3B params on Wan2.1-Fun; the v3-flash path does 768x768 in ~12 GB at 8 steps.
#
# ⚠️ mediapipe IS HERE NOW, AND I GOT THIS WRONG TWICE BEFORE TESTING IT ONCE.
# The comment above says mediapipe "can force a numpy<2 downgrade that breaks
# torch". Three attempts at that constraint:
#
#   1. v0.2-4 pinned `mediapipe>=1.0`, reasoning the warning had gone stale
#      because 1.0.1 declares a bare `numpy`. 1.0 also REMOVED the legacy
#      `solutions` API the nodes import, so ComfyUI logged
#      `ImportError: cannot import name 'solutions' from 'mediapipe'`.
#   2. I then concluded "no version satisfies both", because every 0.10.x release
#      declares numpy<2 and only 0.10.x has `solutions`. Both facts true; the
#      conclusion wrong.
#   3. MEASURED, finally: mediapipe 0.10.21 installed with --no-deps imports
#      `solutions` and runs face detection on a real array against numpy 2.4.1,
#      with torch untouched.
#
# `numpy<2` is a CONSERVATIVE DECLARATION, not a runtime requirement. --no-deps is
# what stops pip acting on the declaration; the package itself does not care. Both
# earlier conclusions came from reading version metadata, and the thing that
# settled it was running the code -- which cost one disposable container.
#
# ⚠️ SO patch-echomimic.sh's FIRST SECTION IS NOW A NO-OP, AND IS KEPT ANYWAY. Its
# try/except simply succeeds. It stays because it is the honest fallback on an
# image without mediapipe, and because deleting the record would erase the reason
# the rest of this comment exists. Its other two sections are still load-bearing.
RUN python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
      mediapipe==0.10.21
#
# ⚠️ diffusers IS NOT IN THE BASE VENV, which is easy to assume it would be.
# ComfyUI implements its own pipelines and does not depend on it; this node does.
# v0.2-4 shipped without it and failed at origin_infer.py line 4 with
# `No module named 'diffusers'` — the SECOND import error in a row, each one
# visible only after a full image build and a restart. Both were avoidable by
# reading the node's requirements.txt against the venv rather than against my
# assumptions about it.
#
# Deliberately NOT installed, and each would break something that works:
#   opencv-python  — opencv-python-headless is already above; both would fight
#   tensorflow / retina-face / decord / mmgp — the STANDALONE repo needs these;
#     this node does not, and tensorflow is hard-pinned to 2.15.0 upstream
# This list was derived by walking the node's EAGER import chain rather than by
# copying its requirements.txt: __init__ -> EchoMimic_node -> {utils, origin_infer,
# echomimic_v3/infer, echomimic_v3/infer_flash_pro} and the v3 src tree. Two builds
# were spent discovering one missing name at a time, which is the expensive way.
#
# retinaface is NOT here on purpose, and its absence was checked rather than
# assumed: echomimic_v3/src/face_detect.py imports it at top level, and nothing in
# the tree imports face_detect. It is dead code in this node, so the tensorflow
# 2.15.0 pin behind it never loads.
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      diffusers \
      accelerate \
      librosa \
      decord \
      loguru \
      more_itertools \
      pyloudnorm \
      imageio-ffmpeg \
      moviepy \
      ffmpeg-python \
      av \
      omegaconf \
      lpips \
      torchmetrics \
      torchtyping \
      IPython

# ⚠️ FAIL AT BUILD TIME, NOT FOUR MINUTES LATER IN A JOURNAL. Every missing name
# above was discovered one per cycle: build the image, rebuild the system, restart
# the container, read the log, find ONE more ModuleNotFoundError. Four rounds of
# that (mediapipe, diffusers, src/dist, decord) before this line existed.
#
# This imports the third-party modules the node's eager chain touches, so a gap
# stops the build with the name in the output instead of shipping an image that
# cannot load the node. It is not a substitute for running the thing -- it proves
# the modules import, not that the node works -- but it moves the cheapest class
# of failure to the cheapest place to find it.
#
# decord is the interesting one: last released 2021, and its only linux artefact is
# `decord-0.6.0-py3-none-manylinux2010_x86_64.whl` -- a universal py3 wheel, so it
# installs on 3.12 despite predating it. A check for cpXX tags says it is
# unavailable, which is what I concluded before looking at the filenames.
# ⚠️ `import importlib.util`, NOT `import importlib`. The submodule is not pulled
# in by importing the package, so the first version of this check died with
# `AttributeError: module 'importlib' has no attribute 'util'` and FAILED THE
# BUILD -- the gate written to make a missing module cheap to find was itself
# broken by a missing import, and cost a build cycle of its own. Suspect the probe
# before the thing it measures.
RUN python3 -c "import importlib.util, sys; \
    mods = ['torch','torchvision','torchaudio','transformers','diffusers','accelerate', \
            'librosa','decord','loguru','more_itertools','pyloudnorm','imageio', \
            'imageio_ffmpeg','moviepy','ffmpeg','av','omegaconf','lpips','torchmetrics', \
            'torchtyping','IPython','cv2','numpy','PIL','safetensors','huggingface_hub', \
            'einops','skimage','onnxruntime','requests','regex','matplotlib','tqdm', \
            'mediapipe','face_alignment','DeepCache']; \
    bad = [m for m in mods if not importlib.util.find_spec(m)]; \
    print(f'import check: {len(mods)-len(bad)}/{len(mods)} present'); \
    sys.exit('MISSING: ' + ', '.join(bad) if bad else 0)"

# LatentSync (ComfyUI-LatentSyncWrapper) — the OTHER half of the avatar capability:
# re-dubbing an EXISTING video with new audio, where EchoMimicV3 animates a still
# portrait. ByteDance, Apache-2.0 for code and weights, 512x512.
#
# mediapipe is above; decord, soundfile, diffusers, omegaconf, einops, opencv,
# ffmpeg-python, safetensors, huggingface_hub and transformers are all already in
# the image. face-alignment and DeepCache are what remain, and both were checked
# in a disposable container first: installing them leaves numpy at 2.4.1 and torch
# at 2.9.1+rocm7.2.
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      face-alignment \
      DeepCache
