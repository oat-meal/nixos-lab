# Derived ComfyUI image for RDNA4 (Radeon RX 9070 XT, gfx1201) — the image-gen
# render node on workstation-nixos. Sibling to ./Containerfile (the server's gfx1151
# image); same model: the /storage/comfyui VOLUME holds the full ComfyUI tree (core +
# custom_nodes code + models, rsynced from the server), and THIS image supplies only
# the runtime (torch/ROCm) + the Python deps those pieces need.
#
# Base: yanwk/comfyui-boot ROCm 7.2 / PyTorch 2.12. gfx1201 is natively supported —
# verified on the workstation 2026-06-16: torch sees the 9070 XT with NO
# HSA_OVERRIDE, and sustained rocBLAS+MIOpen+SDPA stress (400 matmul/conv iters and
# 60 diffusion-like renders with alloc churn) ran with zero HIP crashes and no leak.
#
# Build out-of-band with rootful podman so the (root) oci-containers service sees it:
#   cd /etc/nixos/ai-lab/comfyui && sudo podman build -f Containerfile.gfx1201 -t localhost/comfyui-gfx1201-render:v2 .
# Bump the tag (v2, v3…) when deps change, then `sudo systemctl restart podman-comfyui-render`.
# The localhost/ prefix keeps podman from trying to pull it from a registry.

# Pinned by digest after verification (== :base-rocm72-pt212-20260518) so the base
# can't shift under us. Resolve/refresh with:
#   skopeo inspect docker://docker.io/yanwk/comfyui-boot:base-rocm72-pt212-20260518
# Tag kept for readability; the digest is what is used (pinned 2026-10-10 to the index the
# tag resolved to then — the base the current image was built from).
FROM docker.io/yanwk/comfyui-boot:base-rocm72-pt212-20260518@sha256:8574a031dea0d53b624d932580eb2ed985cf032c4985e2f0395513a858539348

# ComfyUI CORE deps. The code lives in the volume, but its Python requirements must be
# in the image's site-packages. Clone shallow only to grab requirements.txt, install,
# then discard the clone (the volume provides the actual main.py / comfy/ at runtime).
RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI /tmp/comfyui \
 && python3 -m pip install --break-system-packages --no-cache-dir -r /tmp/comfyui/requirements.txt \
 && rm -rf /tmp/comfyui

# CUSTOM-NODE Python deps (node code itself comes from the volume's custom_nodes/).
# Mirrors the server image: Impact Pack + Subpack (detectors/detailer), ControlNet aux
# (CPU onnxruntime — this is AMD, onnxruntime-gpu is NVIDIA-only), IPAdapter_plus
# (+insightface/onnx for FaceID), Ultimate SD Upscale. mediapipe intentionally OMITTED
# (it can force a numpy<2 downgrade that breaks torch; the preprocessors we use don't
# need it).
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      opencv-python-headless scikit-image piexif dill \
      segment-anything ultralytics "git+https://github.com/facebookresearch/sam2" \
      onnxruntime einops insightface onnx \
      addict yacs yapf ftfy fvcore trimesh albumentations scikit-learn

# Background-removal / matting: ComfyUI-Inspyrenet-Rembg (local CPU alpha matting — cleaner
# soft-alpha cutouts than the flood-fill keyer, for sprites/items). Node code is in the
# volume's custom_nodes/; this supplies its single Python dep (pulls timm/kornia/gdown).
RUN python3 -m pip install --break-system-packages --no-cache-dir transparent-background

WORKDIR /opt/ComfyUI
EXPOSE 8188
# Bind 0.0.0.0 inside the container; the host port-maps it to 127.0.0.1 (loopback —
# the image-gen consumers run on this same host).
CMD ["python3", "main.py", "--listen", "0.0.0.0", "--port", "8188"]
